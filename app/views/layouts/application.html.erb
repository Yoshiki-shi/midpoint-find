<!DOCTYPE html>
<html lang="ja">
  <head>
    <%= display_meta_tags(default_meta_tags) %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body style="background-color: #eef1f4; color: #1f2937; min-height: 100vh; display: flex; flex-direction: column; margin: 0;">
    <% unless controller_name == "shares" && action_name == "show" %>
      <header style="background-color: #ffffff; border-bottom: 1px solid #d1d5db;">
        <div style="max-width: 960px; margin: 0 auto; padding: 0 16px; height: 52px; display: flex; align-items: center; justify-content: space-between;">
          <% logo_path = logged_in? ? new_meeting_event_path : root_path %>
          <%= link_to "Meet Halfway", logo_path, style: "font-weight: 700; color: #111827; text-decoration: none; font-size: 15px;" %>

          <% if controller_name == "meeting_events" && action_name == "show" %>
            <%= link_to "ホームに戻る", new_meeting_event_path, style: "background-color: #6b7280; color: #ffffff; padding: 6px 14px; border-radius: 6px; text-decoration: none; font-size: 13px; font-weight: 600;" %>
          <% else %>
            <nav style="display: flex; align-items: center; gap: 12px; font-size: 13px;">
              <% if logged_in? %>
                <%= link_to "ホーム", new_meeting_event_path, style: "color: #374151; text-decoration: none; font-weight: 500;" %>
                <%= link_to "メンバー管理", members_path, style: "color: #374151; text-decoration: none; font-weight: 500;" %>
                <%= link_to "マイページ", profile_path, style: "color: #374151; text-decoration: none; font-weight: 500;" %>
                <%= button_to "ログアウト", logout_path, method: :delete, style: "background-color: #f3f4f6; color: #374151; border: 1px solid #d1d5db; padding: 5px 10px; border-radius: 6px; font-size: 12px; cursor: pointer;" %>
              <% else %>
                <%= link_to "ログイン", login_path, style: "color: #374151; text-decoration: none; font-weight: 500;" %>
                <%= link_to "新規登録", signup_path, style: "background-color: #6b7280; color: #ffffff; padding: 6px 12px; border-radius: 6px; text-decoration: none; font-weight: 600;" %>
              <% end %>
            </nav>
          <% end %>
        </div>
      </header>
    <% end %>

    <main style="max-width: 960px; width: 100%; margin: 28px auto; padding: 0 16px; flex: 1; box-sizing: border-box;">
      <% flash.each do |type, message| %>
        <div style="margin-bottom: 16px; padding: 10px 14px; border-radius: 8px; font-size: 13px; background-color: <%= type.to_s == 'alert' ? '#fef2f2' : '#ffffff' %>; border: 1px solid <%= type.to_s == 'alert' ? '#fca5a5' : '#9ca3af' %>; color: <%= type.to_s == 'alert' ? '#991b1b' : '#1f2937' %>;">
          <%= message %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer style="background-color: #ffffff; border-top: 1px solid #d1d5db; margin-top: 32px;">
      <div style="max-width: 960px; margin: 0 auto; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: #6b7280;">
        <span>Meet Halfway</span>
        <div style="display: flex; gap: 16px;">
          <%= link_to "利用規約", terms_path, style: "color: #6b7280; text-decoration: none;" %>
          <%= link_to "プライバシーポリシー", privacy_path, style: "color: #6b7280; text-decoration: none;" %>
        </div>
      </div>
    </footer>
  </body>
</html>