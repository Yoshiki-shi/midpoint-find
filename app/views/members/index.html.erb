<div style="max-width: 560px; margin: 0 auto; background-color: #ffffff; border: 1.5px solid #9ca3af; border-radius: 10px; padding: 24px; box-shadow: 0 2px 6px rgba(0,0,0,0.05);">
  <h1 style="font-size: 18px; font-weight: 700; color: #111827; margin: 0 0 4px 0;">メンバー管理</h1>
  <p style="font-size: 12px; color: #4b5563; margin: 0 0 18px 0;">自分のデフォルト駅と、よく集まるメンバーの最寄り駅を登録・管理できます。</p>

  <% if current_user.errors.any? || @member.errors.any? %>
    <div style="background-color: #fef2f2; border: 1px solid #fca5a5; color: #991b1b; border-radius: 6px; padding: 10px 12px; font-size: 12px; margin-bottom: 16px;">
      <ul style="margin: 0; padding-left: 18px;">
        <% (current_user.errors.full_messages + @member.errors.full_messages).each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="background-color: #f9fafb; border: 1px solid #d1d5db; border-radius: 8px; padding: 16px; margin-bottom: 18px;">
    <div style="font-size: 13px; font-weight: 700; color: #111827; margin-bottom: 10px;">
      自分のデフォルト駅：<%= current_user.nearest_station_name.presence || "未設定" %>
    </div>
    <%= form_with model: current_user, url: update_default_station_members_path, method: :patch, local: true do |f| %>
      <div style="display: flex; gap: 8px; align-items: center;">
        <%= f.text_field :nearest_station_name, placeholder: "例: 高円寺", style: "flex: 1; box-sizing: border-box; border: 1px solid #9ca3af; border-radius: 6px; padding: 8px 10px; font-size: 13px; background-color: #ffffff;" %>
        <%= f.submit "保存", style: "background-color: #6b7280; color: #ffffff; border: none; border-radius: 6px; padding: 8px 16px; font-size: 13px; font-weight: 700; cursor: pointer;" %>
      </div>
    <% end %>
  </div>

  <div style="background-color: #f9fafb; border: 1px solid #d1d5db; border-radius: 8px; padding: 16px; margin-bottom: 20px;">
    <h2 style="font-size: 14px; font-weight: 700; color: #111827; margin: 0 0 12px 0;">メンバー追加</h2>
    <%= form_with model: @member, local: true do |f| %>
      <div style="margin-bottom: 10px;">
        <%= f.label :name, "名前", style: "display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 4px;" %>
        <%= f.text_field :name, placeholder: "例: 幹事太郎", style: "width: 100%; box-sizing: border-box; border: 1px solid #9ca3af; border-radius: 6px; padding: 8px 10px; font-size: 13px; background-color: #ffffff;" %>
      </div>

      <div style="margin-bottom: 12px;">
        <%= f.label :station_name, "最寄り駅", style: "display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 4px;" %>
        <%= f.text_field :station_name, placeholder: "例: 新宿", style: "width: 100%; box-sizing: border-box; border: 1px solid #9ca3af; border-radius: 6px; padding: 8px 10px; font-size: 13px; background-color: #ffffff;" %>
      </div>

      <%= f.hidden_field :lat %>
      <%= f.hidden_field :lng %>

      <%= f.submit "追加", style: "background-color: #6b7280; color: #ffffff; border: none; border-radius: 6px; padding: 8px 20px; font-size: 13px; font-weight: 700; cursor: pointer;" %>
    <% end %>
  </div>

  <div>
    <h2 style="font-size: 14px; font-weight: 700; color: #111827; margin: 0 0 10px 0;">よく集まるメンバー一覧</h2>
    <% if @members.any? %>
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <% @members.each do |member| %>
          <div style="background-color: #f9fafb; border: 1px solid #d1d5db; border-radius: 8px; padding: 10px 14px; display: flex; justify-content: space-between; align-items: center; gap: 10px;">
            <span style="font-size: 13px; font-weight: 600; color: #111827;">
              <%= member.name %> <span style="font-weight: 400; color: #4b5563;">(<%= member.station_name %>)</span>
            </span>
            <div style="display: flex; gap: 8px;">
              <%= link_to "編集", edit_member_path(member), style: "background-color: #ffffff; border: 1px solid #9ca3af; border-radius: 6px; padding: 4px 10px; font-size: 12px; color: #1f2937; text-decoration: none;" %>
              <%= link_to "削除", member_path(member), data: { turbo_method: :delete, turbo_confirm: "#{member.name}さんを削除してもよろしいですか？" }, style: "background-color: #ffffff; border: 1px solid #fca5a5; border-radius: 6px; padding: 4px 10px; font-size: 12px; color: #991b1b; text-decoration: none;" %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div style="background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 12px; font-size: 12px; color: #6b7280;">
        まだメンバーが登録されていません。
      </div>
    <% end %>
  </div>
</div>
