<div class="max-w-4xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6">メンバー・出発駅の管理</h1>

  <!-- 登録フォーム -->
  <div class="bg-white p-6 rounded-lg shadow mb-8">
    <h2 class="text-lg font-semibold mb-4">メンバーを追加</h2>
    <%= form_with model: @new_member, local: true do |f| %> <!-- ★ @new_member に変更 -->
      <div class="mb-4">
        <%= f.label :name, "メンバー名（例: 自分、友人A）", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, class: "w-full border-gray-300 rounded-md shadow-sm border p-2" %>
      </div>
      <div class="mb-4">
        <%= f.label :station_name, "最寄り駅（例: 高円寺駅）", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :station_name, class: "w-full border-gray-300 rounded-md shadow-sm border p-2" %>
      </div>
      <%= f.submit "登録する", class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
    <% end %>
  </div>

  <!-- 登録済みメンバー一覧 -->
  <div class="bg-white p-6 rounded-lg shadow">
    <h2 class="text-lg font-semibold mb-4">登録済みメンバー一覧</h2>
    <% if @members.any? %>
      <ul class="divide-y divide-gray-200">
        <% @members.each do |member| %>
          <% next unless member.id.present? %> <!-- ★ IDが空（nil）のものはここで完全にスキップする！ -->
          <li class="py-4 flex justify-between items-center">
            <div>
              <p class="font-bold text-lg"><%= member.name %></p>
              <p class="text-gray-600">最寄り駅: <%= member.station_name %></p>
            </div>
            <div>
              <%= link_to "編集", edit_member_path(member), class: "text-blue-600 hover:underline mr-4" %>
              <%= link_to "削除", member_path(member), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "text-red-600 hover:underline" %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-gray-500">まだメンバーが登録されていません。</p>
    <% end %>
  </div>
</div>