<div class="max-w-4xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6">よく遊ぶメンバー一覧</h1>

  <%# エラーメッセージ表示 %>
  <% if @member.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <ul>
        <% @member.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# 新規登録フォーム %>
  <div class="bg-white shadow rounded-lg p-6 mb-8">
    <h2 class="text-lg font-semibold mb-4">メンバーを追加</h2>
    <%= form_with model: @member, local: true, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :name, "名前（ニックネーム可）", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 border p-2" %>
      </div>

      <div>
        <%= f.label :station_name, "最寄り駅", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :station_name, placeholder: "例: 高円寺", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 border p-2" %>
      </div>

      <%# 緯度・経度の隠しフィールド（後ほどAPI連携で自動設定されますが、プレースホルダーとして保持） %>
      <%= f.hidden_field :lat %>
      <%= f.hidden_field :lng %>

      <div>
        <%= f.submit "登録する", class: "w-full bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700 transition" %>
      </div>
    <% end %>
  </div>

  <%# メンバー一覧リスト %>
  <div class="bg-white shadow rounded-lg p-6">
    <h2 class="text-lg font-semibold mb-4">登録済みメンバー一覧</h2>
    <% if @members.any? %>
      <ul class="divide-y divide-gray-200">
        <% @members.each do |member| %>
          <li class="py-4 flex justify-between items-center">
            <div>
              <p class="font-medium text-gray-900"><%= member.name %></p>
              <p class="text-sm text-gray-500">最寄り駅: <%= member.station_name %>駅</p>
            </div>
            <div class="space-x-2">
              <%= link_to "編集", edit_member_path(member), class: "text-indigo-600 hover:text-indigo-900 text-sm font-medium" %>
              <%= link_to "削除", member_path(member), data: { turbo_method: :delete, turbo_confirm: "#{member.name}さんを削除してもよろしいですか？" }, class: "text-red-600 hover:text-red-900 text-sm font-medium" %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-gray-500">まだメンバーが登録されていません。</p>
    <% end %>
  </div>
</div>