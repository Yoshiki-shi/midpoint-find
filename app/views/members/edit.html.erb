<div class="max-w-xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6">メンバー情報の編集</h1>

  <div class="bg-white p-6 rounded-lg shadow">
    <%= form_with model: @member, local: true do |f| %>
      <div class="mb-4">
        <%= f.label :name, "メンバー名", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, class: "w-full border-gray-300 rounded-md shadow-sm border p-2" %>
      </div>
      <div class="mb-4">
        <%= f.label :station_name, "最寄り駅", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :station_name, class: "w-full border-gray-300 rounded-md shadow-sm border p-2" %>
      </div>
      <div class="flex justify-between items-center">
        <%= f.submit "更新する", class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
        <%= link_to "戻る", members_path, class: "text-gray-600 hover:underline" %>
      </div>
    <% end %>
  </div>
</div>