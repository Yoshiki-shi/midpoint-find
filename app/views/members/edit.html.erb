<div class="max-w-xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6">メンバー情報の編集</h1>

  <% if @member.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <ul>
        <% @member.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white shadow rounded-lg p-6">
    <%= form_with model: @member, local: true, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :name, "名前", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 border p-2" %>
      </div>

      <div>
        <%= f.label :station_name, "最寄り駅", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :station_name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 border p-2" %>
      </div>

      <%= f.hidden_field :lat %>
      <%= f.hidden_field :lng %>

      <div class="flex justify-between items-center">
        <%= link_to "戻る", members_path, class: "text-gray-600 hover:text-gray-900 text-sm" %>
        <%= f.submit "更新する", class: "bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700 transition" %>
      </div>
    <% end %>
  </div>
</div>