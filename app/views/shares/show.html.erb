<div style="max-width: 680px; margin: 0 auto; background-color: #ffffff; border: 1.5px solid #9ca3af; border-radius: 10px; padding: 24px; box-shadow: 0 2px 6px rgba(0,0,0,0.05);">
  <div style="background-color: #f3f4f6; border: 1px solid #d1d5db; border-radius: 8px; padding: 18px; text-align: center; margin-bottom: 20px;">
    <div style="font-size: 11px; font-weight: 700; color: #4b5563; margin-bottom: 4px;">共有リンク（閲覧専用）</div>
    <h1 style="font-size: 22px; font-weight: 800; color: #111827; margin: 0 0 4px 0;">
      <%= @meeting_event.title.presence || "#{@meeting_event.midpoint_station_name}駅" %>
    </h1>
    <div style="font-size: 14px; font-weight: 700; color: #1f2937; margin-bottom: 8px;">
      集合おすすめ駅: <%= @meeting_event.midpoint_station_name %>駅
    </div>

    <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 6px;">
      <% @meeting_event.meeting_participants.each do |participant| %>
        <% dist = MidpointCalculatorService.haversine_distance(participant.lat, participant.lng, @meeting_event.midpoint_lat, @meeting_event.midpoint_lng) %>
        <span style="background-color: #ffffff; border: 1px solid #d1d5db; border-radius: 6px; padding: 4px 10px; font-size: 12px; color: #1f2937;">
          <%= participant.name.presence || "参加者" %>（<%= participant.station_name %> / 約<%= dist %>km）
        </span>
      <% end %>
    </div>
  </div>

  <div style="margin-bottom: 22px;">
    <h2 style="font-size: 15px; font-weight: 700; color: #111827; margin: 0 0 10px 0;">おすすめのお店候補</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px;">
      <% @restaurants.each do |shop| %>
        <div style="background-color: #f9fafb; border: 1px solid #d1d5db; border-radius: 8px; padding: 14px; display: flex; flex-direction: column; justify-content: space-between; gap: 10px;">
          <div>
            <div style="font-size: 14px; font-weight: 700; color: #111827; margin-bottom: 4px;"><%= shop[:name] %></div>
            <div style="font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 4px;">★ <%= shop[:rating] %></div>
            <div style="font-size: 12px; color: #4b5563; line-height: 1.4;"><%= shop[:vicinity] %></div>
          </div>
          <%= link_to "Googleマップで見る", shop[:maps_url], target: "_blank", rel: "noopener noreferrer", style: "display: block; text-align: center; background-color: #6b7280; color: #ffffff; padding: 7px 10px; border-radius: 6px; text-decoration: none; font-size: 12px; font-weight: 600;" %>
        </div>
      <% end %>
    </div>
  </div>

  <div style="text-align: center;">
    <%= link_to "アプリを使ってみる", root_path, style: "display: inline-block; background-color: #6b7280; color: #ffffff; padding: 10px 24px; border-radius: 6px; text-decoration: none; font-size: 13px; font-weight: 700;" %>
  </div>
</div>
