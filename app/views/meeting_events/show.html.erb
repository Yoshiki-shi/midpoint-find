<% share_url = share_event_url(@meeting_event.share_token) %>

<div class="space-y-8" data-controller="clipboard" data-clipboard-url-value="<%= share_url %>">
  <div class="bg-gradient-to-br from-slate-900 to-slate-950 border border-emerald-500/40 rounded-2xl p-8 text-center shadow-xl">
    <span class="inline-block bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-xs font-bold px-3 py-1 rounded-full mb-3">
      <%= @meeting_event.title.presence || "みんなの集合場所提案" %>
    </span>
    <h1 class="text-4xl sm:text-5xl font-extrabold text-white mb-2">
      🚃 <%= @meeting_event.midpoint_station_name %>駅
    </h1>
    <% if @meeting_event.midpoint_line_name.present? %>
      <p class="text-emerald-400 text-sm font-medium mb-6"><%= @meeting_event.midpoint_line_name %></p>
    <% end %>

    <div class="flex flex-wrap justify-center gap-3 mt-4">
      <% @meeting_event.meeting_participants.each do |participant| %>
        <% dist = MidpointCalculatorService.haversine_distance(participant.lat, participant.lng, @meeting_event.midpoint_lat, @meeting_event.midpoint_lng) %>
        <div class="bg-slate-950/90 border border-slate-800 px-4 py-2 rounded-xl text-xs">
          <span class="text-slate-300 font-bold"><%= participant.name.presence || "参加者" %></span>
          <span class="text-slate-400">（<%= participant.station_name %>）</span>
          <span class="text-emerald-400 font-semibold ml-1">約 <%= dist %> km</span>
        </div>
      <% end %>
    </div>

    <div class="mt-6 flex flex-col sm:flex-row justify-center items-center gap-3">
      <button type="button"
              data-action="click->clipboard#copy"
              class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold px-6 py-3 rounded-xl text-sm transition cursor-pointer">
        📋 共有URLをコピーする
      </button>
      <%= link_to "共有ページを開く ↗", share_event_path(@meeting_event.share_token), target: "_blank", rel: "noopener noreferrer", class: "bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 px-5 py-3 rounded-xl text-sm transition" %>
    </div>
  </div>

  <div>
    <h2 class="text-xl font-bold text-white mb-4">🍻 <%= @meeting_event.midpoint_station_name %>駅周辺のお店候補（3件）</h2>
    <div class="grid sm:grid-cols-3 gap-6">
      <% @restaurants.each do |shop| %>
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-start gap-2 mb-2">
              <h3 class="font-bold text-white text-base"><%= shop[:name] %></h3>
              <span class="bg-amber-500/10 text-amber-400 border border-amber-500/30 text-xs font-bold px-2 py-0.5 rounded-lg shrink-0">
                ★ <%= shop[:rating] %>
              </span>
            </div>
            <p class="text-xs text-slate-400 mb-4"><%= shop[:vicinity] %></p>
          </div>
          <%= link_to "Googleマップで見る ↗", shop[:maps_url], target: "_blank", rel: "noopener noreferrer", class: "w-full text-center bg-slate-800 hover:bg-emerald-500 hover:text-slate-950 text-emerald-400 font-bold py-2.5 rounded-xl text-xs transition block" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
