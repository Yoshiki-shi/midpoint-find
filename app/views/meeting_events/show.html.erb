<% share_url = share_event_url(@meeting_event.share_token) %>
<% event_label = @meeting_event.title.presence || "#{@meeting_event.midpoint_station_name}駅での集合" %>

<div style="max-width: 680px; margin: 0 auto; background-color: #ffffff; border: 1.5px solid #9ca3af; border-radius: 10px; padding: 24px; box-shadow: 0 2px 6px rgba(0,0,0,0.05);"
     data-controller="clipboard"
     data-clipboard-url-value="<%= share_url %>"
     data-clipboard-title-value="<%= event_label %>">
  <div style="background-color: #f3f4f6; border: 1px solid #d1d5db; border-radius: 8px; padding: 18px; text-align: center; margin-bottom: 20px;">
    <% if @meeting_event.title.present? %>
      <div style="font-size: 13px; font-weight: 700; color: #374151; margin-bottom: 6px;">
        <%= @meeting_event.title %>
      </div>
    <% end %>

    <% if @meeting_event.scheduled_at.present? %>
      <div style="font-size: 15px; font-weight: 700; color: #111827; margin-bottom: 4px;">
        日時：<%= @meeting_event.scheduled_at.strftime("%Y/%m/%d %H:%M") %>
      </div>
    <% end %>

    <h1 style="font-size: 22px; font-weight: 800; color: #111827; margin: 0 0 4px 0;">
      集合駅：<%= @meeting_event.midpoint_station_name %>駅
    </h1>

    <% if @meeting_event.midpoint_line_name.present? %>
      <div style="font-size: 12px; color: #4b5563; margin-bottom: 10px;"><%= @meeting_event.midpoint_line_name %></div>
    <% end %>

    <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin-top: 10px;">
      <% @meeting_event.meeting_participants.each do |participant| %>
        <% dist = MidpointCalculatorService.haversine_distance(participant.lat, participant.lng, @meeting_event.midpoint_lat, @meeting_event.midpoint_lng) %>
        <span style="background-color: #ffffff; border: 1px solid #d1d5db; border-radius: 6px; padding: 4px 10px; font-size: 12px; color: #1f2937;">
          <%= participant.name.presence || "参加者" %>（<%= participant.station_name %> / 約<%= dist %>km）
        </span>
      <% end %>
    </div>

    <% if @meeting_event.note.present? %>
      <div style="margin-top: 12px; background-color: #ffffff; border: 1px solid #d1d5db; border-radius: 6px; padding: 10px 12px; text-align: left; font-size: 12px; color: #1f2937;">
        <div style="font-weight: 700; color: #374151; margin-bottom: 4px;">備考</div>
        <div style="line-height: 1.5;"><%= simple_format(h(@meeting_event.note), {}, wrapper_tag: "span") %></div>
      </div>
    <% end %>
  </div>

  <div style="margin-bottom: 22px;">
    <h2 style="font-size: 15px; font-weight: 700; color: #111827; margin: 0 0 10px 0;">おすすめのお店候補（3件）</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px;">
      <% @restaurants.each do |shop| %>
        <div style="background-color: #f9fafb; border: 1px solid #d1d5db; border-radius: 8px; padding: 14px; display: flex; flex-direction: column; justify-content: space-between; gap: 10px;">
          <div>
            <div style="font-size: 14px; font-weight: 700; color: #111827; margin-bottom: 4px;"><%= shop[:name] %></div>
            <div style="font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 4px;">★ <%= shop[:rating] %></div>
            <div style="font-size: 12px; color: #4b5563; line-height: 1.4;"><%= shop[:vicinity] %></div>
          </div>
          <%= link_to "Googleマップで見る", shop[:maps_url], target: "_blank", rel: "noopener noreferrer", style: "display: block; text-align: center; background-color: #6b7280; color: #ffffff; padding: 7px 10px; border-radius: 6px; text-decoration: none; font-size: 12px; font-weight: 600;" %>
        </div>
      <% end %>
    </div>
  </div>

  <div style="display: flex; flex-direction: column; gap: 8px;">
    <button type="button"
            data-action="click->clipboard#shareLine"
            style="width: 100%; background-color: #06C755; color: #ffffff; border: none; border-radius: 6px; padding: 10px; font-size: 13px; font-weight: 700; cursor: pointer;">
      LINEで送る
    </button>
    <button type="button"
            data-action="click->clipboard#copy"
            style="width: 100%; background-color: #6b7280; color: #ffffff; border: none; border-radius: 6px; padding: 10px; font-size: 13px; font-weight: 700; cursor: pointer;">
      共有用URLをコピー
    </button>
    <%= link_to "ホームに戻る", new_meeting_event_path, style: "display: block; text-align: center; background-color: #ffffff; color: #1f2937; border: 1px solid #9ca3af; border-radius: 6px; padding: 9px; font-size: 13px; font-weight: 600; text-decoration: none;" %>
  </div>
</div>
