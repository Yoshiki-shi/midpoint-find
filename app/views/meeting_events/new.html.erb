<div class="max-w-2xl mx-auto bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-xl" data-controller="participants">
  <h1 class="text-2xl font-extrabold text-white mb-2">集合場所（中間駅）を計算する</h1>
  <p class="text-sm text-slate-400 mb-6">参加者の出発駅を入力すると、最も遠い2人の中間に近い駅と周辺のお店を提案します。</p>

  <% if logged_in? %>
    <div class="mb-6 bg-slate-950 border border-slate-800 rounded-xl p-4">
      <div class="flex justify-between items-center mb-2">
        <p class="text-xs font-semibold text-slate-400">登録済みメンバー（自分・仲間）からワンタップ追加：</p>
        <%= link_to "＋ メンバー・自分の駅を管理", members_path, class: "text-xs text-emerald-400 hover:underline font-medium" %>
      </div>
      <% if current_user.members.any? %>
        <div class="flex flex-wrap gap-2">
          <% current_user.members.each do |member| %>
            <button type="button"
                    data-action="click->participants#addMember"
                    data-name="<%= member.name %>"
                    data-station="<%= member.station_name %>"
                    class="bg-slate-800 hover:bg-emerald-500/20 hover:border-emerald-500/50 border border-slate-700 text-xs text-slate-200 px-3 py-1.5 rounded-lg transition">
              ＋ <%= member.name %>（<%= member.station_name %>）
            </button>
          <% end %>
        </div>
      <% else %>
        <p class="text-xs text-slate-500">まだ最寄り駅が登録されていません。「メンバー・自分の駅を管理」から登録するとワンタップで入力できます。</p>
      <% end %>
    </div>
  <% end %>

  <%= form_with model: @meeting_event, local: true, class: "space-y-6" do |f| %>
    <% if @meeting_event.errors.any? %>
      <div class="bg-red-950/60 border border-red-500/50 text-red-200 p-4 rounded-xl text-sm">
        <ul class="list-disc pl-5 space-y-1">
          <% @meeting_event.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :title, "イベント名（任意）", class: "block text-sm font-medium text-slate-300 mb-1" %>
      <%= f.text_field :title, placeholder: "例: 金曜夜の飲み会", class: "w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:border-emerald-400 focus:outline-none" %>
    </div>

    <div data-participants-target="container" class="space-y-3">
      <%= f.fields_for :meeting_participants do |pf| %>
        <div class="participant-row flex gap-2 items-center">
          <%= pf.text_field :name, placeholder: "名前（例: 自分）", data: { field: "name" }, class: "w-1/3 bg-slate-950 border border-slate-700 rounded-xl px-3 py-2.5 text-white text-sm" %>
          <%= pf.text_field :station_name, required: true, placeholder: "出発駅（例: 高円寺）", data: { field: "station" }, class: "flex-grow bg-slate-950 border border-slate-700 rounded-xl px-3 py-2.5 text-white text-sm" %>
          <button type="button" data-action="click->participants#remove" class="text-slate-500 hover:text-red-400 px-2 py-2 text-sm">✕</button>
        </div>
      <% end %>
    </div>

    <template data-participants-target="template">
      <div class="participant-row flex gap-2 items-center">
        <input type="text" name="meeting_event[meeting_participants_attributes][NEW_RECORD][name]" placeholder="名前" data-field="name" class="w-1/3 bg-slate-950 border border-slate-700 rounded-xl px-3 py-2.5 text-white text-sm">
        <input type="text" name="meeting_event[meeting_participants_attributes][NEW_RECORD][station_name]" required placeholder="出発駅（例: 与野）" data-field="station" class="flex-grow bg-slate-950 border border-slate-700 rounded-xl px-3 py-2.5 text-white text-sm">
        <button type="button" data-action="click->participants#remove" class="text-slate-500 hover:text-red-400 px-2 py-2 text-sm">✕</button>
      </div>
    </template>

    <div>
      <button type="button" data-action="click->participants#add" class="w-full py-2.5 border border-dashed border-slate-700 hover:border-emerald-400 text-slate-300 hover:text-emerald-400 rounded-xl text-sm font-medium transition">
        ＋ 参加者を追加する
      </button>
    </div>

    <%= f.submit "中間駅とお店候補を検索する", class: "w-full bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold py-4 rounded-xl shadow-lg shadow-emerald-500/20 transition cursor-pointer text-base" %>
  <% end %>
</div>
