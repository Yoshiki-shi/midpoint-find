<div style="max-width: 520px; margin: 0 auto; background-color: #ffffff; border: 1.5px solid #9ca3af; border-radius: 10px; padding: 24px; box-shadow: 0 2px 6px rgba(0,0,0,0.05);" data-controller="participant-form">
  <div style="font-size: 11px; font-weight: 700; color: #6b7280; margin-bottom: 2px;">ホーム</div>
  <h1 style="font-size: 18px; font-weight: 700; color: #111827; margin: 0 0 14px 0;">参加メンバー出発駅入力</h1>

  <% if logged_in? && current_user.members.any? %>
    <div style="background-color: #f9fafb; border: 1px solid #d1d5db; border-radius: 8px; padding: 10px 12px; margin-bottom: 14px;">
      <div style="font-size: 12px; font-weight: 600; color: #4b5563; margin-bottom: 8px;">登録メンバーから追加</div>
      <div style="display: flex; flex-wrap: wrap; gap: 6px;">
        <% current_user.members.each do |member| %>
          <button type="button"
                  data-action="click->participant-form#addMember"
                  data-name="<%= member.name %>"
                  data-station="<%= member.station_name %>"
                  style="background-color: #ffffff; border: 1px solid #9ca3af; border-radius: 6px; padding: 4px 10px; font-size: 12px; color: #1f2937; cursor: pointer;">
            ＋ <%= member.name %>（<%= member.station_name %>）
          </button>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= form_with model: @meeting_event, local: true do |f| %>
    <% if @meeting_event.errors.any? %>
      <div style="background-color: #fef2f2; border: 1px solid #fca5a5; color: #991b1b; border-radius: 6px; padding: 10px 12px; font-size: 12px; margin-bottom: 14px;">
        <ul style="margin: 0; padding-left: 18px;">
          <% @meeting_event.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div style="margin-bottom: 12px;">
      <%= f.label :title, "イベント名（任意）", style: "display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 4px;" %>
      <%= f.text_field :title, placeholder: "例: 金曜の飲み会", style: "width: 100%; box-sizing: border-box; border: 1px solid #9ca3af; border-radius: 6px; padding: 8px 10px; font-size: 13px;" %>
    </div>

    <div data-participant-form-target="container" style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 10px;">
      <%= f.fields_for :meeting_participants do |pf| %>
        <div class="participant-row" style="display: flex; gap: 8px; align-items: center;">
          <%= pf.text_field :name, placeholder: "名前", data: { field: "name" }, style: "width: 32%; box-sizing: border-box; border: 1px solid #9ca3af; border-radius: 6px; padding: 8px 10px; font-size: 13px;" %>
          <%= pf.text_field :station_name, required: true, placeholder: "出発駅（例: 新宿）", data: { field: "station" }, style: "flex: 1; box-sizing: border-box; border: 1px solid #9ca3af; border-radius: 6px; padding: 8px 10px; font-size: 13px;" %>
          <button type="button" data-action="click->participant-form#remove" style="background: none; border: none; color: #6b7280; font-size: 14px; cursor: pointer; padding: 4px 6px;">✕</button>
        </div>
      <% end %>
    </div>

    <template data-participant-form-target="template">
      <div class="participant-row" style="display: flex; gap: 8px; align-items: center;">
        <input type="text" name="meeting_event[meeting_participants_attributes][NEW_RECORD][name]" placeholder="名前" data-field="name" style="width: 32%; box-sizing: border-box; border: 1px solid #9ca3af; border-radius: 6px; padding: 8px 10px; font-size: 13px;">
        <input type="text" name="meeting_event[meeting_participants_attributes][NEW_RECORD][station_name]" required placeholder="出発駅（例: 渋谷）" data-field="station" style="flex: 1; box-sizing: border-box; border: 1px solid #9ca3af; border-radius: 6px; padding: 8px 10px; font-size: 13px;">
        <button type="button" data-action="click->participant-form#remove" style="background: none; border: none; color: #6b7280; font-size: 14px; cursor: pointer; padding: 4px 6px;">✕</button>
      </div>
    </template>

    <div style="margin-bottom: 14px;">
      <button type="button" data-action="click->participant-form#add" style="background-color: #f3f4f6; border: 1px dashed #9ca3af; border-radius: 6px; padding: 6px 12px; font-size: 12px; font-weight: 600; color: #374151; cursor: pointer;">
        ＋ メンバー追加
      </button>
    </div>

    <%= f.submit "中間駅を計算する", style: "width: 100%; background-color: #6b7280; color: #ffffff; border: none; border-radius: 6px; padding: 10px; font-size: 14px; font-weight: 700; cursor: pointer;" %>
  <% end %>

  <% if logged_in? %>
    <div style="margin-top: 22px; padding-top: 16px; border-top: 1px solid #d1d5db;">
      <h2 style="font-size: 14px; font-weight: 700; color: #111827; margin: 0 0 10px 0;">最近の計算履歴</h2>
      <% if (@recent_meeting_events || []).any? %>
        <div style="display: flex; flex-direction: column; gap: 8px;">
          <% @recent_meeting_events.each do |event| %>
            <div style="background-color: #f9fafb; border: 1px solid #d1d5db; border-radius: 8px; padding: 10px 12px; display: flex; justify-content: space-between; align-items: center; gap: 8px;">
              <div>
                <div style="font-size: 13px; font-weight: 700; color: #111827;">
                  <%= event.title.presence || "#{event.midpoint_station_name.presence || '中間駅'}の予定" %>
                </div>
                <div style="font-size: 11px; color: #4b5563;">
                  <%= event.midpoint_station_name.present? ? "中間駅: #{event.midpoint_station_name}" : "未計算" %>
                </div>
              </div>
              <%= link_to "結果を見る", meeting_event_path(event), style: "background-color: #ffffff; border: 1px solid #9ca3af; border-radius: 6px; padding: 5px 10px; font-size: 12px; color: #1f2937; text-decoration: none; font-weight: 600;" %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div style="background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 10px 12px; font-size: 12px; color: #6b7280;">
          まだ計算履歴はありません。
        </div>
      <% end %>
    </div>
  <% end %>
</div>